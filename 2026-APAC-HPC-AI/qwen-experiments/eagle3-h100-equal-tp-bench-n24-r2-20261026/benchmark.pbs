#!/bin/bash
#PBS -P 59010042
#PBS -q normal
#PBS -N ap42-equal-tp-n24-r2
#PBS -l select=1:ncpus=112:ngpus=8:mpiprocs=1
#PBS -l place=scatter:excl
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail

export QWEN_ALLOCATION_T0=$(date +%s)
export QWEN_CPU_ENVELOPE_MODE=legacy
export QWEN_NODE_PREFETCH=off
export QWEN_RESOURCE_MONITOR=1
export QWEN_TELEMETRY_MAX_S=1650
export QWEN_BUNDLE=/scratch/users/industry/ai-hpc/apacsc42/qwen-pbs-20261015/eagle3-h100-equal-tp-bench-n24-r2-20261026
export SLURM_SUBMIT_DIR=/scratch/users/industry/ai-hpc/apacsc42/qwen-pbs-20261015
export SLURM_JOB_ID=$PBS_JOBID SLURM_JOB_NODELIST=from-pbs-nodefile
export QWEN_EXPERIMENT_ID=eagle3-h100-equal-tp-bench-n24-r2-20261026
export QWEN_NIXL_PATCH_SHA256=912b7edb95b03604354cc0137f111756ed5bb0eaa91345e713afa53b5bf5024f

cd "$QWEN_BUNDLE"
sha256sum --check SHA256SUMS
ART="$SLURM_SUBMIT_DIR/runs/$PBS_JOBID"
mkdir -p "$ART"
python3 "$QWEN_BUNDLE/whole-node-preflight.py" "$ART/whole-node-assignment.json"
python3 "$QWEN_BUNDLE/prerequisite-check.py" \
  --bundle "$QWEN_BUNDLE" --out "$ART"
source "$QWEN_BUNDLE/pbs-shim.sh"
exec /bin/bash "$QWEN_BUNDLE/topology-job.sh"
