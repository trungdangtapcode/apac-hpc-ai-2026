{
  "models": {
    "items": [
      {
        "name": "qwen"
      }
    ]
  },
  "endpoint": {
    "urls": [
      "DYNAMIC_ALLOCATED_ROUTER"
    ],
    "type": "chat",
    "path": "/v1/chat/completions",
    "api_key": "<redacted>",
    "streaming": true,
    "headers": {
      "Accept": "text/event-stream"
    },
    "extra": {
      "min_tokens": 200,
      "max_tokens": 200,
      "ignore_eos": true,
      "temperature": 0.0,
      "repetition_penalty": 1.0
    }
  },
  "datasets": [
    {
      "name": "main",
      "type": "synthetic",
      "entries": 12800,
      "random_seed": 2026,
      "prompts": {
        "isl": {
          "mean": 4000.0,
          "stddev": 0.0
        },
        "osl": {
          "mean": 200.0,
          "stddev": 0.0
        },
        "cache_bust": {
          "target": "first_turn_prefix"
        }
      }
    }
  ],
  "phases": [
    {
      "name": "warmup",
      "kind": "warmup",
      "type": "concurrency",
      "exclude_from_results": true,
      "duration": 60.0,
      "concurrency": 66
    },
    {
      "name": "profiling",
      "kind": "profiling",
      "type": "concurrency",
      "duration": 120.0,
      "concurrency": 66,
      "grace_period": 30.0
    }
  ],
  "artifacts": {
    "dir": "DYNAMIC_ARTIFACT_DIRECTORY",
    "auto_plot": false,
    "plot_required": false
  },
  "slos": {
    "time_to_first_token": 3000.0,
    "inter_token_latency": 20.0
  },
  "tokenizer": {
    "name": "Qwen/Qwen3-235B-A22B-Instruct-2507"
  },
  "gpu_telemetry": {
    "enabled": true
  },
  "server_metrics": {
    "enabled": true,
    "urls": [],
    "formats": [
      "json",
      "csv"
    ]
  },
  "network_latency": {
    "enabled": false
  },
  "otel": {},
  "mlflow": {},
  "wandb": {},
  "runtime": {
    "ui": "simple",
    "workers": 66
  }
}
