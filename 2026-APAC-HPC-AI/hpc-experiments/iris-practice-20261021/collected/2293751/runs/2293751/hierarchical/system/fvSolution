FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p     { solver GAMG; smoother GaussSeidel; tolerance 0; relTol 0; maxIter 6;
            coarsestLevelCorr { solver PCG; preconditioner DIC; minIter 12; maxIter 12; } }
    Phi   { $p; }
    U     { solver smoothSolver; smoother GaussSeidel; tolerance 0; relTol 0; maxIter 5; nSweeps 1; }
    k     { solver smoothSolver; smoother GaussSeidel; tolerance 0; relTol 0; maxIter 3; nSweeps 1; }
    omega { solver smoothSolver; smoother GaussSeidel; tolerance 0; relTol 0; maxIter 3; nSweeps 1; }
}
SIMPLE { nNonOrthogonalCorrectors 0; consistent yes; }
potentialFlow { nNonOrthogonalCorrectors 5; }
relaxationFactors { equations { U 0.9; k 0.6; omega 0.6; } }
cache { grad(U); }
