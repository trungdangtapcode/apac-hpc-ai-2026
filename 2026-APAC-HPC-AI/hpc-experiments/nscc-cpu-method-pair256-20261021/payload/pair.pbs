#!/bin/bash
# Native official two-node / 80-step matched Basic baseline.
#PBS -N tu-cpu-HS256
#PBS -P 59000042
#PBS -q normal
#PBS -l select=2:ncpus=128:mpiprocs=128:mem=440gb:ngpus=0
#PBS -l place=scatter:excl
#PBS -l walltime=00:40:00
#PBS -j oe
set -eo pipefail
: "${PBS_JOBID:?}" "${PBS_O_WORKDIR:?}"
ROOT=$PBS_O_WORKDIR
RUN="$ROOT/runs/${PBS_JOBID%%.*}"
test ! -e "$RUN"
mkdir -p "$RUN"
python3 "$ROOT/batch-lifecycle.py" start "$RUN"
finish_wrapper() {
 local result=$?
 set +e
 python3 "$ROOT/batch-lifecycle.py" finish "$RUN" "$result"
 exit "$result"
}
trap finish_wrapper EXIT
if . /app/apps/resetmodule; then :; else exit 1; fi
module load openfoam/2512
test "$WM_PROJECT_VERSION" = 2512
test "$WM_PRECISION_OPTION" = DP
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 WM_NCOMPPROCS=4
export FI_VERBS_PREFER_XRC=0
cd "$ROOT"
python3 verify-inputs.py
{ date -u; hostname; module list 2>&1; lscpu; } > "$RUN/environment.log"
if [ -n "${PBS_NODEFILE:-}" ]; then cat "$PBS_NODEFILE" > "$RUN/pbs-nodefile.txt"; fi
mpirun -np 256 python3 "$ROOT/rank-probe.py" > "$RUN/rank-placement.jsonl" 2> "$RUN/rank-placement.stderr"
python3 - "$RUN/rank-placement.jsonl" <<'PY_RANK'
import json,sys,collections
rows=[json.loads(x) for x in open(sys.argv[1]) if x.strip()]
assert sorted(x['rank'] for x in rows)==list(range(256))
assert sorted(collections.Counter(x['host'] for x in rows).values())==[128,128]
assert all(len(x['affinity'])==1 for x in rows)
assert len(set((x['host'],tuple(x['physical_core'])) for x in rows))==256
blocks=[set(x['host'] for x in rows if x['rank']//128==g) for g in range(2)]
assert all(len(v)==1 for v in blocks) and blocks[0]!=blocks[1]
PY_RANK
phase() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" | tee -a "$RUN/phases.log"; }
run_stage() {
 local label=$1
 local log=$2
 shift 2
 phase "$label"
 /usr/bin/time -v timeout --signal=TERM --kill-after=15s 1800s mpirun -np 256 "$@" > "$log" 2>&1
 python3 - "$log" <<'PY_LOG'
from pathlib import Path
import sys,re
s=Path(sys.argv[1]).read_text()
assert re.search(r'^End\s*$',s,re.M) and 'FOAM FATAL' not in s and 'died from signal' not in s
assert 'OPENFOAM=2512' in s and 'scalar=64' in s
assert re.search(r'^nProcs\s*:\s*256\s*$',s,re.M)
PY_LOG
}
for role in control candidate; do
 ART=$(python3 -c "import json;print(json.load(open('$ROOT/inputs.json'))['$role'])")
 mkdir -p "$RUN/${role}-init"
 cd "$ART"
 . "$WM_PROJECT_DIR/bin/tools/RunFunctions"
 restore0Dir -processor > "$RUN/${role}-init/restore0Dir.log" 2>&1
 run_stage "${role}_renumber" "$RUN/${role}-init/renumberMesh.log" renumberMesh -constant -overwrite -parallel
 run_stage "${role}_potential" "$RUN/${role}-init/potentialFoam.log" potentialFoam -initialiseUBCs -parallel
 run_stage "${role}_boundary" "$RUN/${role}-init/applyBoundaryLayer.log" applyBoundaryLayer -ybl 0.0450244 -parallel
 python3 "$ROOT/field-seal.py" "$ART" "$RUN/${role}-before.json"
 DEST="$RUN/$role"
 mkdir -p "$DEST/logFiles"
 cp -a "$ART/system" "$DEST/system"
 ln -s "$ART/constant" "$DEST/constant"
 for p in "$ART"/processor*; do ln -s "$p" "$DEST/$(basename "$p")"; done
 cd "$DEST"
 foamDictionary system/controlDict -entry startFrom -set startTime > logFiles/control-set.stdout 2> logFiles/control-set.stderr
 foamDictionary system/controlDict -entry endTime -set 80 >> logFiles/control-set.stdout 2>> logFiles/control-set.stderr
 run_stage "${role}_simpleFoam" "$DEST/logFiles/simpleFoam.log" simpleFoam -parallel
 python3 "$ROOT/validate-solve.py" "$DEST"
 phase "${role}_field_verification"
 python3 "$ROOT/field-seal.py" "$ART" "$RUN/${role}-after.json" "$RUN/${role}-before.json"
done
phase pair_complete
printf 'CPU_HS256_PAIR_PASS\n'
