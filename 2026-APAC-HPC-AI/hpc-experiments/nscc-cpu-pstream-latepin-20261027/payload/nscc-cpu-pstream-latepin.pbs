#!/bin/bash
#PBS -N pstream-latepin
#PBS -P 59000042
#PBS -q normal
#PBS -l select=4:ncpus=128:mpiprocs=128:mem=32gb:ngpus=0
#PBS -l place=scatter:excl
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?}" "${PBS_O_WORKDIR:?}" "${PBS_NODEFILE:?}"
ROOT=$(cd "$PBS_O_WORKDIR" && pwd -P)
RUN="$ROOT/runs/${PBS_JOBID%%.*}"
test ! -e "$RUN" || { echo 'run path already exists' >&2; exit 2; }
umask 077
mkdir -p "$RUN/logs" "$RUN/resources" "$RUN/commands"
cp "$PBS_NODEFILE" "$RUN/pbs-nodefile.txt"
# Leave at least 25 seconds before the PBS walltime; forced termination adds at most five seconds.
if timeout --signal=TERM --kill-after=5s 575s bash "$ROOT/payload/worker.sh" "$ROOT" "$RUN"; then
    exit 0
else
    rc=$?
    printf 'WORKER_EXIT=%s\n' "$rc" >>"$RUN/outer-status.txt"
    exit "$rc"
fi
